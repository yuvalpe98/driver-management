generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DRIVER
  MANAGER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EquipmentStatus {
  GOOD
  NEEDS_REPAIR
  MISSING
}

enum TaskType {
  DELIVERY
  MAINTENANCE
}

enum TaskPriority {
  URGENT
  NORMAL
  LOW
}

enum CatalogCategory {
  INVENTORY
  EQUIPMENT
}

model User {
  id           String   @id @default(uuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTasks     Task[]             @relation("DriverTasks")
  createdTasks      Task[]             @relation("ManagerTasks")
  auditLogs         AuditLog[]
  equipment         Equipment[]
  inventory         InventoryItem[]    @relation("DriverInventory")
  pushSubscriptions PushSubscription[]
}

model Task {
  id                 String       @id @default(uuid())
  title              String
  description        String?
  deliveryAddress    String
  status             TaskStatus   @default(PENDING)
  taskType           TaskType     @default(DELIVERY)
  priority           TaskPriority @default(NORMAL)
  scheduledFor       DateTime?
  completedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  assignedDriverId   String
  assignedDriver     User       @relation("DriverTasks", fields: [assignedDriverId], references: [id])

  createdByManagerId String
  createdByManager   User       @relation("ManagerTasks", fields: [createdByManagerId], references: [id])

  completion         TaskCompletion?
  items              TaskItem[]

  @@index([assignedDriverId])
  @@index([status])
}

model TaskCompletion {
  id                String   @id @default(uuid())
  recipientName     String
  signatureImageUrl String
  completedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  taskId            String   @unique
  task              Task     @relation(fields: [taskId], references: [id])
}

model TaskItem {
  id       String @id @default(uuid())
  name     String
  quantity Int

  taskId   String
  task     Task   @relation(fields: [taskId], references: [id])

  @@index([taskId])
}

model CatalogItem {
  id        String          @id @default(uuid())
  name      String          @unique
  category  CatalogCategory
  unit      String?                          // only relevant for INVENTORY items
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  inventoryItems InventoryItem[]
  equipment      Equipment[]
}

model InventoryItem {
  id            String      @id @default(uuid())
  quantity      Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  driverId      String
  driver        User        @relation("DriverInventory", fields: [driverId], references: [id])

  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])

  @@unique([driverId, catalogItemId])
  @@index([driverId])
}

model Equipment {
  id            String          @id @default(uuid())
  status        EquipmentStatus @default(GOOD)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  driverId      String
  driver        User            @relation(fields: [driverId], references: [id])

  catalogItemId String
  catalogItem   CatalogItem     @relation(fields: [catalogItemId], references: [id])

  @@index([driverId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String
  ipAddress  String?
  createdAt  DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
}

model PushSubscription {
  id       String @id @default(uuid())
  endpoint String @unique
  p256dh   String
  auth     String

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
